<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: required for microphone access; without it TCC
	     silently denies and the app never appears in Privacy > Microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Allow loading the embedded Sparkle framework under Hardened Runtime. The
	     local "Yappy Local Signing" dev cert has no Apple Team ID, so Library
	     Validation rejects the (matching-cert, no-Team-ID) framework at launch.
	     Developer ID release builds re-sign Sparkle with the same real Team ID, so
	     this is only strictly required for local installs — but it is notarization-
	     safe and standard for apps embedding third-party frameworks. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
